# Copy to .env and fill in. Variable names are the ones @midscene/web reads
# (ref: midscene-example/playwright-with-vitest-demo/README.md,
#  node_modules/@midscene/shared/dist/types/env).
# Any OpenAI-compatible vision model endpoint works.

# Example: Qwen3-VL on Aliyun DashScope
MIDSCENE_MODEL_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
MIDSCENE_MODEL_API_KEY="sk-your-key"
MIDSCENE_MODEL_NAME="qwen3-vl-plus"
# One of: qwen3-vl, qwen2.5-vl, doubao-vision, doubao-seed, gemini, gpt-5, glm-v, vlm-ui-tars, ...
MIDSCENE_MODEL_FAMILY="qwen3-vl"

# Optional
# HEADLESS=false              # show the browser window
# MIDSCENE_CACHE=true         # reuse AI planning/locate cache between runs
