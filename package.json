{
  "name": "multi-test-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI-driven web automation test scaffold (Midscene + Vitest + Allure) — week 1 milestone",
  "scripts": {
    "test": "vitest run",
    "test:web": "vitest run --project web",
    "test:android": "vitest run --project android",
    "loop:android": "tsx scripts/loop-android.ts",
    "report": "tsx scripts/report.ts",
    "typecheck": "tsc --noEmit",
    "crash-check:android": "tsx scripts/crash-check-android.ts"
  },
  "devDependencies": {
    "@midscene/android": "1.16.0",
    "@midscene/web": "^1.16.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "3.13.0",
    "allure-vitest": "^3.13.0",
    "dotenv": "^18.0.8",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
