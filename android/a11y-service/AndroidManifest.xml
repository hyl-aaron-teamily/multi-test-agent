<?xml version="1.0" encoding="utf-8"?>
<!-- autotest read-only tree service (W2-4 §4.1). Exports the accessibility tree over the phone's loopback
     to the host (adb forward). No gestures, no screenshots, no network beyond 127.0.0.1. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.autotest.a11y"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />

    <!-- Needed for any socket, including the loopback-only server. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <service
            android:name=".TreeService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tree_service" />
        </service>

        <!-- Token drop: only a sender holding WRITE_SECURE_SETTINGS (the adb shell user, the system) can
             deliver it, so no app on the phone can set a token and read the tree. Same guard as Artemis'
             helper (ref/artemis, Apache-2.0). -->
        <receiver
            android:name=".TokenReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="ai.autotest.a11y.SET_TOKEN" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
