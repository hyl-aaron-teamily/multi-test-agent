 "2044/main/android-app": {
  "title": "引用块预览应显示链接文本而不是 Markdown 源码",
  "targets": [
   {
    "id": "conv",
    "kind": "group-conversation",
    "guidance": "a group conversation whose members are all test accounts"
   }
  ],
  "setup": [
   {
    "type": "node",
    "node": {
     "name": "teamily.openConversation",
     "input": {
      "target": "conv"
     }
    },
    "delayAfterMs": 1000
   }
  ],
  "prepare": [
   {
    "type": "node",
    "node": {
     "name": "teamily.sendMessage",
     "input": {
      "text": "https://github.com/TensorOpera-Inc/chat-web/pull/654",
      "kind": "markdown-link"
     }
    },
    "delayAfterMs": 1000
   },
   {
    "type": "node",
    "node": {
     "name": "teamily.quoteReply",
     "input": {
      "quote": "github.com/TensorOpera-Inc/chat-web/pull/654",
      "text": "autotest-2044 quote"
     }
    },
    "delayAfterMs": 1000
   }
  ],
  "prepareCheck": {
   "kind": "text",
   "scope": "quote-cards",
   "match": {
    "contains": "github.com/TensorOpera-Inc/cha"
   },
   "expect": "会话里出现引用了该链接消息的引用块",
   "want": "present"
  },
  "actions": [
   {
    "type": "tap",
    "delayAfterMs": 900,
    "element": "chat.back"
   },
   {
    "type": "node",
    "node": {
     "name": "teamily.openConversation",
     "input": {
      "target": "conv"
     }
    },
    "delayAfterMs": 1000
   },
   {
    "type": "wait",
    "delayAfterMs": 1000,
    "value": "1000"
   }
  ],
  "checks": [
   {
    "kind": "text",
    "scope": "quote-cards",
    "match": {
     "regex": "\\]\\(https?://"
    },
    "expect": "引用块预览不出现 Markdown 链接语法 [..](..)（链接只显示一次）",
    "want": "absent"
   }
  ]
 },
