{
 "1329/s1/android-app": {
  "title": "点赞后立即可见",
  "targets": [
   {
    "id": "conv",
    "kind": "group-conversation",
    "guidance": "成员 ≥3 的群聊（会话列表头像为多人拼图，或名称含多个成员名/逗号）；@ 类问题用它"
   },
   {
    "id": "msg",
    "kind": "others-text-message",
    "guidance": "别人发的普通文本消息（不是图片/卡片/系统消息，也不是链接/URL——点到链接会打开浏览器），点赞类问题用它"
   },
   {
    "id": "like",
    "kind": "like-action",
    "guidance": "长按消息后出现的点赞 \"👍\" 表情按钮"
   }
  ],
  "setup": [
   {
    "type": "node",
    "node": {
     "name": "teamily.openConversation",
     "input": {
      "target": "conv"
     }
    },
    "delayAfterMs": 800
   }
  ],
  "actions": [
   {
    "type": "longPress",
    "element": "target.msg",
    "delayAfterMs": 900
   },
   {
    "type": "tap",
    "element": "target.like",
    "delayAfterMs": 1000
   }
  ],
  "checks": [
   {
    "kind": "text",
    "match": {
     "exact": "👍"
    },
    "scope": {
     "target": "msg",
     "within": 160
    },
    "expect": "The liked message shows a like / 👍 reaction under it",
    "want": "present"
   }
  ],
  "afterCheck": [
   {
    "type": "longPress",
    "element": "target.msg",
    "delayAfterMs": 900
   },
   {
    "type": "tap",
    "element": "target.like",
    "delayAfterMs": 1000
   }
  ]
 },
