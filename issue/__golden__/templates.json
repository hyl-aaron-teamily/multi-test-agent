 "1594/main/android-app": {
  "title": "@ 成员选择器弹出（切换会话后循环）",
  "targets": [
   {
    "id": "group",
    "kind": "group-conversation",
    "guidance": "成员 ≥3 的群聊（会话列表头像为多人拼图，或名称含多个成员名/逗号）；@ 类问题用它"
   },
   {
    "id": "other",
    "kind": "other-conversation",
    "guidance": "与目标群不同的任意会话（用于切换会话再切回）"
   }
  ],
  "setup": [
   {
    "type": "node",
    "node": {
     "name": "teamily.openConversation",
     "input": {
      "target": "group"
     }
    },
    "delayAfterMs": 800
   }
  ],
  "actions": [
   {
    "type": "node",
    "node": {
     "name": "teamily.clearComposer",
     "input": {}
    },
    "delayAfterMs": 200
   },
   {
    "type": "node",
    "node": {
     "name": "teamily.openConversation",
     "input": {
      "target": "other"
     }
    },
    "delayAfterMs": 500
   },
   {
    "type": "node",
    "node": {
     "name": "teamily.openConversation",
     "input": {
      "target": "group"
     }
    },
    "delayAfterMs": 700
   },
   {
    "type": "node",
    "node": {
     "name": "teamily.typeMention",
     "input": {}
    },
    "delayAfterMs": 700
   }
  ],
  "checks": [
   {
    "kind": "visual-region",
    "page": "mention-picker",
    "region": "picker",
    "expect": "输入 @ 后成员/智能体选择器弹出",
    "want": "present",
    "onlyOnAnomaly": true,
    "requires": {
     "composerHas": "@"
    }
   },
   {
    "kind": "crash",
    "expect": "无崩溃 / 页面错误",
    "want": "absent"
   }
  ]
 },
