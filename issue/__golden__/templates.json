 "1329/s2/android-app": {
  "title": "点引用定位应稳定跳到被引用消息",
  "targets": [
   {
    "id": "conv",
    "kind": "group-conversation",
    "guidance": "成员 ≥3 的群聊（会话列表头像为多人拼图，或名称含多个成员名/逗号）；@ 类问题用它"
   },
   {
    "id": "link",
    "kind": "quote-card",
    "guidance": "会话底部最近的一条引用回复里的引用块（左侧竖线 + 原发送人 + 原文；引用的是普通文字，不是链接 / URL）"
   }
  ],
  "setup": [
   {
    "type": "node",
    "node": {
     "name": "teamily.openConversation",
     "input": {
      "target": "conv"
     }
    },
    "delayAfterMs": 1000
   }
  ],
  "actions": [
   {
    "type": "tap",
    "element": "target.link",
    "delayAfterMs": 1000
   },
   {
    "type": "wait",
    "delayAfterMs": 1000,
    "value": "1000"
   }
  ],
  "checks": [
   {
    "kind": "baseline",
    "expect": "点引用块后跳到被引用的原消息（每轮落在同一位置）",
    "want": "present"
   }
  ],
  "afterCheck": [
   {
    "type": "tap",
    "delayAfterMs": 900,
    "element": "chat.back"
   },
   {
    "type": "node",
    "node": {
     "name": "teamily.openConversation",
     "input": {
      "target": "conv"
     }
    },
    "delayAfterMs": 1000
   },
   {
    "type": "wait",
    "delayAfterMs": 1000,
    "value": "1000"
   }
  ]
 },
