      "delayAfterMs": 0
    },
    {
      "type": "node",
      "node": {
        "name": "teamily.tapSend",
        "input": {}
      },
      "delayAfterMs": 1000
    },
    {
      "type": "wait",
      "value": "1000",
      "delayAfterMs": 1000
