      "value": "autotest-1903 {token} {round} ",
      "delayAfterMs": 300
    },
    {
      "type": "type",
      "value": "@",
      "delayAfterMs": 1000
    },
    {
      "type": "wait",
      "value": "1000",
      "delayAfterMs": 0
